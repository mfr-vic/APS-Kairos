{
  "name": "kairos",
  "version": "0.1.0",
  "private": true,
  "description": "Distributed systems mobile app for São Paulo urban environmental data",
  "workspaces": [
    "packages/contracts",
    "apps/api",
    "apps/mobile"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/api",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "npm run format --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "eslint": "^8.54.0",
    "prettier": "^3.1.0",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  }
}
