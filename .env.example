# Καιρός — modelo de ambiente. Copie para .env (nunca commite o .env).
#   PowerShell: Copy-Item .env.example .env
# Credenciais ficam só aqui, no backend. Nunca use EXPO_PUBLIC_* para segredos.

# --- Banco (PostgreSQL + PostGIS) ---
DB_PASSWORD=troque-esta-senha
DB_PORT=5432

# --- API ---
NODE_ENV=development
LOG_LEVEL=info
API_PORT=3000

# --- Provedores externos ---
SPTRANS_TOKEN=
# TomTom: rotas de carro/a pé e trânsito (RF22, RF24). Vazia = OSRM, sem trânsito.
TOMTOM_KEY=
# ARTESP: pode ficar vazia; o provedor opera em modo degradado sem a chave.
ARTESP_KEY=
# OSRM e Nominatim: opcionais; vazias = servidores públicos (≤ 1 req/s, User-Agent próprio).
OSRM_BASE_URL=
NOMINATIM_BASE_URL=

# --- Modo demonstração ---
DEMO_MODE=false
# Token exigido no cabeçalho X-Demo-Token; use pelo menos 32 caracteres aleatórios.
DEMO_TOKEN=troque-este-token

# --- Histórico (RF26) ---
# Segredo do HMAC que transforma o trajeto num código irreversível no banco (RNF14). Use 32+ caracteres
# aleatórios. Vazio = segredo aleatório a cada boot (a contagem de "trajetos distintos" recomeça).
HISTORICO_SEGREDO=

# --- Perfil sd-avancado (Valkey + worker, opcional; RF27) ---
CACHE_PASSWORD=troque-esta-senha
CACHE_PORT=6379
# Liga o cache compartilhado na API do container. Vazia = LRU em memória (padrão).
#   docker compose --profile sd-avancado up -d --build cache worker
#   e depois a api com API_CACHE_URL=redis://cache:6379
API_CACHE_URL=
# Fora do Docker (npm run dev): CACHE_URL=redis://127.0.0.1:6379 usa o Valkey exposto no host.
CACHE_URL=
