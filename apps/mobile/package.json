{
  "name": "kairos-mobile",
  "main": "expo-router/entry",
  "version": "0.5.0",
  "dependencies": {
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@kairos/contracts": "*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/query-async-storage-persister": "^5.104.1",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-query-persist-client": "^5.104.1",
    "expo": "~57.0.28",
    "expo-build-properties": "~57.0.22",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.21",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.12",
    "expo-location": "~57.0.21",
    "expo-network": "~57.0.2",
    "expo-notifications": "~57.0.22",
    "expo-router": "~57.0.26",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^8.57.1",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "dev": "expo start --lan",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "jest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "eas-build-post-install": "cd ../.. && npm run build -w packages/contracts"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "resolver": "react-native-worklets/jest/resolver.js",
    "roots": [
      "<rootDir>/test"
    ],
    "moduleNameMapper": {
      ".css$": "<rootDir>/test/support/style-mock.js",
      "^@react-native-async-storage/async-storage$": "@react-native-async-storage/async-storage/jest/async-storage-mock",
      "^react-native-reanimated$": "<rootDir>/test/support/reanimated-mock.js",
      "^expo-notifications$": "<rootDir>/test/support/expo-notifications-mock.ts",
      "^@/assets/(.*)$": "<rootDir>/assets/$1",
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "testMatch": [
      "**/*.test.[jt]s?(x)"
    ],
    "testTimeout": 20000
  }
}
