{
  "name": "kairos-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch --import tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src/ --ext .ts",
    "format": "prettier --write src/",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "node --env-file-if-exists=../../.env --import tsx database/scripts/migrate.ts",
    "db:import-geosampa": "node --env-file-if-exists=../../.env --import tsx database/scripts/import-geosampa.ts",
    "typecheck": "tsc --noEmit -p test"
  },
  "dependencies": {
    "@kairos/contracts": "*",
    "fastify": "^5.0.0",
    "iovalkey": "^0.4.0",
    "pg": "^8.11.3",
    "pino-pretty": "^11.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.4",
    "@types/pg": "^8.23.1",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^8.54.0",
    "prettier": "^3.1.0",
    "tsx": "^4.19.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  }
}
